# The tibbers u.gg mirror: static files, gzip on disk, nothing dynamic.
#
# Appended to /etc/caddy/Caddyfile by install.sh (a site block of its own;
# the file belongs to other sites too). TLS is automatic once
# data.tibbers.lol resolves here.
#
# The data files exist only as <path>.json.gz, exactly as u.gg sent them. A
# request for <path>.json is rewritten to the sidecar and sent with
# Content-Encoding: gzip whatever Accept-Encoding said -- tibbers and every
# browser accept gzip, and Caddy's own `precompressed` would need the plain
# file beside it. status.json and manifest.json are plain and tiny.

data.tibbers.lol {
	root * /var/lib/tibbers-mirror/public

	# Access logs go to the journal with the rest of Caddy's output
	# (journalctl -u caddy); a per-site file was refused under the unit's
	# sandbox.
	log

	header Access-Control-Allow-Origin "*"
	header X-Content-Type-Options "nosniff"

	@sidecar {
		path *.json
		file {path}.gz
	}
	handle @sidecar {
		rewrite {path}.gz
		header >Content-Type "application/json"
		header >Content-Encoding "gzip"
		header >Cache-Control "public, max-age=300"
		file_server
	}

	@plain path /status.json /manifest.json
	handle @plain {
		header >Cache-Control "no-cache"
		file_server
	}

	handle {
		respond 404
	}
}
