[Unit]
Description=Sync the tibbers u.gg mirror every four hours

[Timer]
# On the boundaries status.json promises (nextRunAt is computed from midnight
# UTC in --interval-hours steps), so clients expiring just after them find
# fresh files. Keep this and --interval-hours in the service in step.
OnCalendar=*-*-* 00/4:00:00 UTC
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
